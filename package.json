{
  "name": "gis-cup-evaluator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "benchmark:sample": "vitest run --config vitest.benchmark.config.ts benchmarks/sample-dataset.test.ts --reporter=verbose",
    "benchmark:stress": "vitest run --config vitest.benchmark.config.ts benchmarks/sample-full-evaluation.test.ts --reporter=verbose",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@arcgis/core": "5.1.0",
    "rbush": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/rbush": "4.0.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
